# Copier en .env (jamais publié) et remplacer les valeurs.
# Jetons : 16 caractères minimum, sans + ni / (ils passent dans des liens).
# Pour en générer un : openssl rand -hex 24

# Téléphone du bus : identifiant d'appareil dans Traccar Client, ou lien /driver.html#t=…
NAVETTE_DRIVER_TOKEN=remplacer-par-un-jeton-aleatoire
# Page /admin.html
NAVETTE_ADMIN_TOKEN=remplacer-par-un-autre-jeton

# Facultatif
NAVETTE_PORT=8080
NAVETTE_DOMAIN=navette.ragnarok-festival.ch
